# Environment template — copy to `.env` and fill in per deployment.
# Real `.env` files are git-ignored and must NEVER be committed.
# Convention: every consumer deployment uses the same key names; values differ.

# --- Application ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (one database per customer; authcore + commerce schemas inside) ---
DATABASE_URL=postgresql://platform:CHANGE_ME@localhost:5432/customer_db

# --- Sessions ---
SESSION_TTL_HOURS=72

# --- Email (v1: dev adapter; a real provider is selected before production) ---
EMAIL_FROM="Reusable Platform <no-reply@invalid.example>"

# No secret values belong in this file: keep it inert.
